[Unit]
Description=Back up OpenLess encrypted sync database
After=openless-cloud-sync.service

[Service]
Type=oneshot
User=openless-sync
Group=openless-sync
ExecStart=/usr/bin/python3 /opt/openless-cloud-sync/current/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/openless-cloud-sync
ReadWritePaths=/var/backups/openless-cloud-sync
