SYNC_BIND=127.0.0.1:8787
SYNC_DATABASE=/var/lib/openless-cloud-sync/sync.db
# Reuse the existing OpenLess OAuth App; keep its client secret on the server only.
SYNC_GITHUB_CLIENT_ID=REPLACE_WITH_OPENLESS_OAUTH_CLIENT_ID
SYNC_GITHUB_CLIENT_SECRET=REPLACE_WITH_OPENLESS_OAUTH_CLIENT_SECRET
SYNC_ALLOW_LOCAL_HTTP=false
# Before independent review and client acceptance, allow only explicit test accounts.
SYNC_ACCESS_MODE=restricted
SYNC_ALLOWED_GITHUB_IDS=
# Native clients have no Origin. Add exact HTTPS origins only when needed.
SYNC_ALLOWED_ORIGINS=
